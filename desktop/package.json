{
  "name": "opendecodesk-desktop",
  "productName": "OpenDecoDesk",
  "version": "0.1.0",
  "description": "OpenDecoDesk's back office as a program on one computer: orders, inventory, expenses and production, with no web shop and no email.",
  "private": true,
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac zip --arm64 --x64"
  },
  "dependencies": {
    "miniflare": "4.20260708.1"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.opendecodesk.desktop",
    "productName": "OpenDecoDesk",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "migrate.js",
      "package.json",
      "!node_modules/workerd/bin/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "../functions",
        "to": "functions"
      },
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../migrations",
        "to": "migrations"
      },
      {
        "from": "../schema.sql",
        "to": "schema.sql"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "OpenDecoDesk-${version}-windows-portable.exe"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "OpenDecoDesk-${version}-mac-${arch}.zip"
    }
  },
  "repository": "github:opendecodesk/opendecodesk",
  "author": "OpenDecoDesk contributors"
}
